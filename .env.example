# Every variable below is OPTIONAL — the app works with zero
# configuration (paste text or drop a PDF, generate speech, done).
# These only unlock extra resilience/features when this is hosted for
# multiple people.

# Upstash Redis (free tier: https://upstash.com — no credit card).
# Shares the TTS circuit breaker + rate limiter across all serverless
# instances. Without these, both still work, just scoped to a single
# warm instance instead of shared globally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Groq (free tier: https://console.groq.com — no credit card). Powers
# the optional "clean up text with AI" feature that fixes PDF-extraction
# line breaks/hyphenation before narration.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini (free tier: https://aistudio.google.com/apikey). Secondary AI
# cleanup provider, used only if Groq is unset or fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# A single shared password gating the whole app (paste text, PDF upload,
# TTS, everything) behind a simple /enter code-entry page. Unset (the
# default) means no gate at all — anyone with the URL can use the app,
# same as before this existed. Set it to anything memorable if you're
# sharing the URL more broadly and want to keep out random/opportunistic
# visitors. This is NOT real per-user authentication — one code, shared
# by everyone you give it to. NEVER set the real value here or commit it
# anywhere — only set it in your host's environment variable dashboard.
SITE_ACCESS_CODE=
